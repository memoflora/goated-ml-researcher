# secrets — never commit
.env
.env.*
*.key

# data and run artifacts
data/
runs/*
!runs/.gitkeep
!runs/examples/
*.npy
*.npz
*.zip
*.tar.gz
KuaiRand-Pure/
*.csv
!tests/fixtures/*.csv

# Curated run artifacts under runs/examples/ are graded deliverables (problem statement
# §2.5 items 3 run logs, 3b interventions, 4a the submission), so they are tracked even
# though every other run output is ignored. The `*.csv` rule above would otherwise
# swallow final/submission.csv, which IS deliverable 4a. Add a run with:
#     python tools/archive_run.py runs/<run_id>
!runs/examples/**/*.csv

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated demo fixture — rebuild with `python tools/make_demo_data.py`
data/demo-regression/

# agent worktrees — real git repos; committing them creates gitlinks in main
.claude/worktrees/
